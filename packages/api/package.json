{
  "name": "@docmd/api",
  "version": "0.10.0",
  "description": "Public API, plugin contracts, and hook interfaces for the docmd documentation engine.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build:registry": "node ../../scripts/build-plugin-registry.mjs",
    "prebuild": "npm run build:registry",
    "build": "tsc && node scripts/copy-registry.mjs"
  },
  "files": [
    "dist",
    "registry"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@docmd/parser": "workspace:*",
    "@docmd/tui": "workspace:*",
    "@docmd/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  },
  "optionalDependencies": {
    "@docmd/engine-js": "workspace:*",
    "@docmd/engine-python": "workspace:*",
    "@docmd/engine-rust": "workspace:*"
  },
  "keywords": [
    "docmd",
    "documentation",
    "plugin-api",
    "hooks",
    "runtime",
    "extension-api",
    "markdown",
    "typescript",
    "ssg",
    "developer-tools",
    "static-site-generator",
    "plugins",
    "lifecycle",
    "mcp"
  ],
  "author": {
    "name": "Ghazi",
    "url": "https://mgks.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docmd-io/docmd.git",
    "directory": "packages/api"
  },
  "bugs": {
    "url": "https://github.com/docmd-io/docmd/issues"
  },
  "homepage": "https://docmd.io",
  "funding": "https://github.com/sponsors/docmd-io",
  "license": "MIT"
}