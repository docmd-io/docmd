{
  "name": "@docmd/template-summer",
  "version": "0.10.0",
  "description": "Official modern clean summer template for docmd documentation sites.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "templates",
    "assets"
  ],
  "devDependencies": {
    "@docmd/api": "workspace:*",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "docmd": {
    "key": "summer",
    "kind": "template",
    "displayName": "Summer",
    "tagline": "A bright, hopeful, summer-feel layout with a top search bar and halo accents.",
    "capabilities": [
      "template"
    ],
    "preview": "assets/css/summer.css"
  },
  "keywords": [
    "docmd",
    "template",
    "theme",
    "summer-theme",
    "layout",
    "responsive-design",
    "accessible",
    "modern-docs",
    "light-dark",
    "minimalist",
    "documentation"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "author": {
    "name": "Ghazi",
    "url": "https://mgks.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docmd-io/docmd.git",
    "directory": "packages/templates/summer"
  },
  "bugs": {
    "url": "https://github.com/docmd-io/docmd/issues"
  },
  "homepage": "https://docmd.io",
  "funding": "https://github.com/sponsors/docmd-io",
  "license": "MIT"
}