{
  "name": "@docmd/live",
  "version": "0.10.0",
  "description": "Interactive in-browser live editor and realtime preview runtime for docmd.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "docmd-live": "bin/docmd-live.js"
  },
  "scripts": {
    "build": "tsc && node ./dist/build.js"
  },
  "files": [
    "bin",
    "dist",
    "public",
    "src"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@docmd/parser": "workspace:*",
    "@docmd/plugin-math": "workspace:*",
    "@docmd/plugin-mermaid": "workspace:*",
    "@docmd/plugin-playground": "workspace:*",
    "@docmd/themes": "workspace:*",
    "@docmd/tui": "workspace:*",
    "@docmd/ui": "workspace:*",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "katex": "^0.19.1",
    "markdown-it-texmath": "^1.0.0"
  },
  "devDependencies": {
    "@docmd/api": "workspace:*",
    "@types/node": "^26.6.6"
  },
  "keywords": [
    "docmd",
    "live-editor",
    "preview",
    "in-browser",
    "realtime",
    "markdown-editor",
    "hot-reload",
    "browser-ide",
    "wysiwyg",
    "documentation",
    "ssg",
    "client-side"
  ],
  "author": {
    "name": "Ghazi",
    "url": "https://mgks.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docmd-io/docmd.git",
    "directory": "packages/live"
  },
  "bugs": {
    "url": "https://github.com/docmd-io/docmd/issues"
  },
  "homepage": "https://docmd.io",
  "funding": "https://github.com/sponsors/docmd-io",
  "license": "MIT"
}