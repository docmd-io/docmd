{
  "name": "@docmd/plugin-sitemap",
  "version": "0.10.0",
  "description": "Automated sitemap.xml generator for docmd documentation sites.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "docmd": {
    "key": "sitemap",
    "kind": "plugin",
    "displayName": "Sitemap",
    "tagline": "Sitemap generator for docmd.",
    "capabilities": [
      "post-build"
    ]
  },
  "scripts": {
    "build": "tsc"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@docmd/api": "workspace:*",
    "@types/node": "^26.6.6"
  },
  "keywords": [
    "docmd",
    "plugin",
    "sitemap",
    "sitemap-xml",
    "crawlers",
    "indexing",
    "seo",
    "xml",
    "search-engine",
    "automated",
    "documentation",
    "ssg"
  ],
  "author": {
    "name": "Ghazi",
    "url": "https://mgks.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docmd-io/docmd.git",
    "directory": "packages/plugins/sitemap"
  },
  "bugs": {
    "url": "https://github.com/docmd-io/docmd/issues"
  },
  "homepage": "https://docmd.io",
  "funding": "https://github.com/sponsors/docmd-io",
  "license": "MIT"
}