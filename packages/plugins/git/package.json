{
  "name": "@docmd/plugin-git",
  "version": "0.10.0",
  "description": "Git-based metadata, contributor histories, and edit links generator for docmd.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "docmd": {
    "key": "git",
    "kind": "plugin",
    "displayName": "Git",
    "tagline": "Git integration with last-updated timestamps and commit history.",
    "capabilities": [
      "init",
      "build",
      "body",
      "assets",
      "post-build",
      "translations"
    ]
  },
  "scripts": {
    "build": "tsc && node build.js"
  },
  "files": [
    "dist",
    "i18n"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@docmd/api": "workspace:*"
  },
  "devDependencies": {
    "@docmd/api": "workspace:*",
    "@types/node": "^26.6.6"
  },
  "keywords": [
    "docmd",
    "plugin",
    "git",
    "git-history",
    "contributors",
    "last-updated",
    "changelog",
    "vcs",
    "edit-link",
    "repository",
    "documentation",
    "ssg"
  ],
  "author": {
    "name": "Ghazi",
    "url": "https://mgks.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docmd-io/docmd.git",
    "directory": "packages/plugins/git"
  },
  "bugs": {
    "url": "https://github.com/docmd-io/docmd/issues"
  },
  "homepage": "https://docmd.io",
  "funding": "https://github.com/sponsors/docmd-io",
  "license": "MIT"
}