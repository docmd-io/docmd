{
  "name": "@docmd/plugin-ai",
  "version": "0.10.0",
  "description": "Interactive in-page AI chat assistant grounded in documentation, powered by docmd-assistant.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "docmd": {
    "key": "ai",
    "kind": "plugin",
    "displayName": "AI Chat",
    "tagline": "Interactive AI chat with documentation powered by docmd-assistant.",
    "capabilities": [
      "init",
      "body",
      "assets",
      "actions",
      "translations",
      "post-build"
    ]
  },
  "scripts": {
    "build": "tsc && node build.js"
  },
  "files": [
    "dist",
    "i18n",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "docmd-assistant": "^0.1.21"
  },
  "devDependencies": {
    "@docmd/api": "workspace:*",
    "@docmd/utils": "workspace:*",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "docmd",
    "plugin",
    "ai",
    "chat",
    "rag",
    "assistant",
    "llm",
    "vector-search",
    "embeddings",
    "ollama",
    "openai",
    "anthropic",
    "gemini",
    "documentation",
    "interactive"
  ],
  "author": {
    "name": "Ghazi",
    "url": "https://mgks.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docmd-io/docmd.git",
    "directory": "packages/plugins/ai"
  },
  "bugs": {
    "url": "https://github.com/docmd-io/docmd/issues"
  },
  "homepage": "https://docmd.io",
  "license": "MIT",
  "funding": "https://github.com/sponsors/docmd-io"
}