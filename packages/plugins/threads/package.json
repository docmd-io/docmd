{
  "name": "@docmd/plugin-threads",
  "version": "0.10.0",
  "type": "module",
  "description": "Inline discussion threads and Markdown review comments plugin for docmd.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "i18n"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "docmd": {
    "key": "threads",
    "kind": "plugin",
    "displayName": "Threads",
    "tagline": "Inline discussion comments stored in Markdown.",
    "capabilities": [
      "markdown",
      "body",
      "assets",
      "actions",
      "translations"
    ],
    "requiresLiveServer": true
  },
  "scripts": {
    "build": "tsc && node build.js",
    "build:client": "node build.js",
    "test": "echo 'TODO: migrate tests to vitest'"
  },
  "peerDependencies": {
    "@docmd/api": "workspace:*",
    "@docmd/parser": "workspace:*"
  },
  "dependencies": {
    "@docmd/utils": "workspace:*",
    "@shoelace-style/shoelace": "^2.20.1",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@docmd/api": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2"
  },
  "keywords": [
    "docmd",
    "plugin",
    "threads",
    "discussions",
    "comments",
    "inline-feedback",
    "git-sync",
    "peer-review",
    "collaboration",
    "annotations",
    "documentation"
  ],
  "author": {
    "name": "Saulo Vallory"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docmd-io/docmd.git",
    "directory": "packages/plugins/threads"
  },
  "license": "MIT",
  "homepage": "https://docmd.io",
  "funding": "https://github.com/sponsors/docmd-io",
  "bugs": {
    "url": "https://github.com/docmd-io/docmd/issues"
  }
}