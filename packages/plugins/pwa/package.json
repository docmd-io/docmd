{
  "name": "@docmd/plugin-pwa",
  "version": "0.10.0",
  "description": "Progressive Web App manifest and offline service worker generator for docmd.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "docmd": {
    "key": "pwa",
    "kind": "plugin",
    "displayName": "PWA",
    "tagline": "Progressive Web App support for docmd with offline caching.",
    "capabilities": [
      "post-build",
      "head",
      "body"
    ]
  },
  "scripts": {
    "build": "tsc"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@docmd/api": "workspace:*"
  },
  "dependencies": {
    "@docmd/utils": "workspace:*"
  },
  "devDependencies": {
    "@docmd/api": "workspace:*",
    "@types/node": "^26.6.6"
  },
  "keywords": [
    "docmd",
    "plugin",
    "pwa",
    "service-worker",
    "offline-first",
    "web-manifest",
    "cache-busting",
    "installable",
    "offline-docs",
    "progressive-web-app",
    "documentation"
  ],
  "author": {
    "name": "Ghazi",
    "url": "https://mgks.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docmd-io/docmd.git",
    "directory": "packages/plugins/pwa"
  },
  "bugs": {
    "url": "https://github.com/docmd-io/docmd/issues"
  },
  "homepage": "https://docmd.io",
  "funding": "https://github.com/sponsors/docmd-io",
  "license": "MIT"
}