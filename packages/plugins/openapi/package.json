{
  "name": "@docmd/plugin-openapi",
  "version": "0.10.0",
  "description": "OpenAPI 3.x REST API reference documentation renderer for docmd.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "docmd": {
    "key": "openapi",
    "kind": "plugin",
    "displayName": "OpenAPI",
    "tagline": "OpenAPI / Swagger spec rendering for docmd.",
    "capabilities": [
      "markdown",
      "assets"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@docmd/api": "workspace:*"
  },
  "dependencies": {
    "@docmd/utils": "workspace:*",
    "js-yaml": "^5.5.0",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@docmd/api": "workspace:*",
    "@types/node": "^26.6.6"
  },
  "keywords": [
    "docmd",
    "plugin",
    "openapi",
    "swagger",
    "api-reference",
    "json-schema",
    "rest-api",
    "api-documentation",
    "spec-viewer",
    "interactive-api",
    "documentation"
  ],
  "author": {
    "name": "Ghazi",
    "url": "https://mgks.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docmd-io/docmd.git",
    "directory": "packages/plugins/openapi"
  },
  "bugs": {
    "url": "https://github.com/docmd-io/docmd/issues"
  },
  "homepage": "https://docmd.io",
  "funding": "https://github.com/sponsors/docmd-io",
  "license": "MIT"
}