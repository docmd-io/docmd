{
  "name": "@docmd/plugin-iconify",
  "version": "0.9.9",
  "description": "Optional Iconify icon integration for docmd documentation containers.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "docmd": {
    "key": "iconify",
    "kind": "plugin",
    "displayName": "Iconify Icons",
    "tagline": "Use 200,000+ open-source icons from Iconify in docmd containers.",
    "capabilities": [
      "markdown",
      "init",
      "doctor"
    ]
  },
  "scripts": {
    "build": "tsc"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@docmd/api": "workspace:*"
  },
  "devDependencies": {
    "@docmd/api": "workspace:*",
    "@docmd/parser": "workspace:*",
    "@docmd/tui": "workspace:*",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "docmd",
    "plugin",
    "iconify",
    "icons",
    "svg",
    "documentation"
  ],
  "author": {
    "name": "docmd.io",
    "url": "https://docmd.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docmd-io/docmd.git"
  },
  "license": "MIT"
}