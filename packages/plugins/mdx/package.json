{
  "name": "@docmd/plugin-mdx",
  "version": "0.9.9",
  "description": "Interactive MDX and JSX component support for docmd documentation sites.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "docmd": {
    "key": "mdx",
    "kind": "plugin",
    "displayName": "MDX Support",
    "tagline": "Author interactive documentation with JSX components and expressions powered by lite-mdx.",
    "capabilities": [
      "build",
      "markdown",
      "doctor"
    ]
  },
  "scripts": {
    "build": "tsc"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "lite-mdx": "^0.1.0"
  },
  "peerDependencies": {
    "@docmd/api": "workspace:*"
  },
  "devDependencies": {
    "@docmd/api": "workspace:*",
    "@docmd/parser": "workspace:*",
    "@docmd/tui": "workspace:*",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "docmd",
    "plugin",
    "mdx",
    "jsx",
    "components",
    "markdown",
    "documentation"
  ],
  "author": {
    "name": "docmd.io",
    "url": "https://docmd.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docmd-io/docmd.git"
  },
  "license": "MIT"
}
