{
  "name": "@docmd/plugin-seo",
  "version": "0.10.0",
  "description": "Automated SEO meta tags, Open Graph, and Twitter Card generator for docmd.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "docmd": {
    "key": "seo",
    "kind": "plugin",
    "displayName": "SEO",
    "tagline": "SEO meta tag generator for docmd.",
    "capabilities": [
      "head",
      "post-build",
      "doctor"
    ]
  },
  "scripts": {
    "build": "tsc"
  },
  "files": [
    "dist"
  ],
