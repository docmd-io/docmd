  "author": {
    "name": "Ghazi",
    "url": "https://mgks.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docmd-io/docmd.git",
    "directory": "packages/plugins/seo"
  },
  "bugs": {
    "url": "https://github.com/docmd-io/docmd/issues"
