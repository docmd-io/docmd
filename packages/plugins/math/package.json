{
  "name": "@docmd/plugin-math",
  "version": "0.10.0",
  "description": "LaTeX mathematics plugin for docmd via KaTeX rendering.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "docmd": {
    "key": "math",
    "kind": "plugin",
    "displayName": "Math",
    "tagline": "Mathematics (KaTeX/LaTeX) plugin for docmd.",
    "capabilities": [
      "markdown",
      "assets"
    ]
  },
  "scripts": {
    "build": "tsc"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "markdown-it-texmath": "^1.0.0"
  },
  "devDependencies": {
    "@docmd/api": "workspace:*"
  },
  "keywords": [
    "docmd",
    "plugin",
    "math",
    "katex",
    "latex",
    "mathematics",
    "equations",
    "formula",
    "client-side",
    "scientific",
    "documentation",
    "ssg"
  ],
  "author": {
    "name": "Ghazi",
    "url": "https://mgks.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docmd-io/docmd.git",
    "directory": "packages/plugins/math"
  },
  "bugs": {
    "url": "https://github.com/docmd-io/docmd/issues"
  },
  "homepage": "https://docmd.io",
  "funding": "https://github.com/sponsors/docmd-io",
  "license": "MIT"
}