{
  "name": "@docmd/core",
  "version": "0.10.0",
  "description": "Documentation compiler for humans and machines. One Markdown source, one command — generates website, search, AI context, and knowledge formats together.",
  "type": "module",
  "browser": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "docmd": "dist/bin/docmd.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/bin/docmd.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@docmd/api": "workspace:*",
    "@docmd/deployer": "workspace:*",
    "@docmd/live": "workspace:*",
    "@docmd/parser": "workspace:*",
    "@docmd/plugin-ai": "workspace:*",
    "@docmd/plugin-analytics": "workspace:*",
    "@docmd/plugin-git": "workspace:*",
    "@docmd/plugin-installer": "workspace:*",
    "@docmd/plugin-llms": "workspace:*",
    "@docmd/plugin-mdx": "workspace:*",
    "@docmd/plugin-mermaid": "workspace:*",
    "@docmd/plugin-okf": "workspace:*",
    "@docmd/plugin-openapi": "workspace:*",
    "@docmd/plugin-playground": "workspace:*",
    "@docmd/plugin-search": "workspace:*",
    "@docmd/plugin-seo": "workspace:*",
    "@docmd/plugin-sitemap": "workspace:*",
    "@docmd/themes": "workspace:*",
    "@docmd/tui": "workspace:*",
    "@docmd/ui": "workspace:*",
    "@docmd/utils": "workspace:*",
    "esbuild": "^0.28.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  },
  "allowScripts": {
    "esbuild": true,
    "@docmd/engine-rust": true,
    "onnxruntime-node": true,
    "protobufjs": true,
    "sharp": true
  },
  "keywords": [
    "docmd",
    "markdown",
    "documentation",
    "static-site-generator",
    "ssg",
    "developer-tools",
    "site-generator",
    "docs",
    "zero-config",
    "minimalist",
    "cli",
    "generator",
    "nodejs",
    "browser",
    "typescript",
    "ai-context",
    "mcp-server"
  ],
  "author": {
    "name": "Ghazi",
    "url": "https://mgks.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docmd-io/docmd.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/docmd-io/docmd/issues"
  },
  "homepage": "https://docmd.io",
  "funding": "https://github.com/sponsors/docmd-io",
  "license": "MIT"
}